{{!
    @template assignfeedback_proctorai/student_marks

    The marks per question a student sees once the teacher has approved or released them.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * rows - label, mark, max and feedback for each question

    Example context (json):
    {
        "rows": [
            {"label": "1", "mark": "2", "max": "2", "feedback": "Correct."},
            {"label": "2a", "mark": "1.5", "max": "3", "feedback": "Show your working."}
        ]
    }
}}
<div class="table-responsive assignfeedback_proctorai_studentmarks">
    <table class="table table-sm">
        <caption>{{#str}} perquestion, assignfeedback_proctorai {{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}} question, assignfeedback_proctorai {{/str}}</th>
                <th scope="col">{{#str}} marks, assignfeedback_proctorai {{/str}}</th>
                <th scope="col">{{#str}} feedback {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <th scope="row">{{label}}</th>
                    <td class="text-nowrap">{{mark}} / {{max}}</td>
                    <td>{{feedback}}</td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
