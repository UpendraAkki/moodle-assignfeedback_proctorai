{{!
    @template assignfeedback_proctorai/grader_panel

    The Proctor AI result in the grader: total, per-question table with editable marks, and the "Use AI grade" button.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="assignfeedback_proctorai-status"
    * data-region="assignfeedback_proctorai-total"
    * data-region="assignfeedback_proctorai-mark", with data-index and data-max
    * data-action="assignfeedback_proctorai-usegrade"

    Context variables required for this template:
    * panelid - Unique id of the panel element
    * status - Job status code
    * statuslabel - Job status text
    * errormessage - Why the job stopped
    * notsent - Which submitted files were not sent to Proctor AI, and why
    * hasresult - Whether there is a result
    * earned, maxmarks, percentage - The total, with any teacher changes
    * reviewcount, needsreview - Questions flagged for review
    * canusegrade, suggestedgrade, suggestedgraderaw, maxgrade - The grade button
    * percentonly - The assignment uses a scale or advanced grading
    * prefilled, approved, pagecount, editable
    * questions - Per-question rows

    Example context (json):
    {
        "panelid": "assignfeedback_proctorai_panel1",
        "status": "done",
        "statuslabel": "Graded by AI",
        "errormessage": "",
        "notsent": "",
        "hasresult": true,
        "earned": "7",
        "maxmarks": "10",
        "percentage": "70",
        "reviewcount": 1,
        "needsreview": true,
        "canusegrade": true,
        "suggestedgrade": "70",
        "suggestedgraderaw": 70,
        "maxgrade": "100",
        "percentonly": false,
        "prefilled": true,
        "approved": false,
        "pagecount": 2,
        "editable": true,
        "questions": [
            {
                "index": 0,
                "label": "1",
                "earned": "2",
                "markraw": 2,
                "max": "2",
                "maxraw": 2,
                "aiearned": "2",
                "edited": false,
                "editable": true,
                "feedback": "Correct.",
                "studentanswer": "Paris",
                "reasoning": "Matches the expected answer.",
                "confidence": "95%",
                "needsreview": false,
                "reviewreason": ""
            },
            {
                "index": 1,
                "label": "2a",
                "earned": "1",
                "markraw": 1,
                "max": "3",
                "maxraw": 3,
                "aiearned": "0",
                "edited": true,
                "editable": true,
                "feedback": "Working is unclear.",
                "studentanswer": "x = 4?",
                "reasoning": "The final line is hard to read.",
                "confidence": "40%",
                "needsreview": true,
                "reviewreason": "Handwriting is unclear"
            }
        ]
    }
}}
<div id="{{panelid}}" class="assignfeedback_proctorai_panel card mb-3" data-status="{{status}}">
    <div class="card-body p-2">
        <h4 class="h6 card-title mb-2">{{#str}} pluginname, assignfeedback_proctorai {{/str}}</h4>
        <p class="mb-2" data-region="assignfeedback_proctorai-status" aria-live="polite">
            <span class="badge bg-secondary">{{statuslabel}}</span>
            {{#errormessage}}<span class="text-danger small d-block">{{errormessage}}</span>{{/errormessage}}
        </p>
        {{#notsent}}
            <div class="alert alert-warning py-1 px-2 mb-2 small" data-region="assignfeedback_proctorai-notsent">{{notsent}}</div>
        {{/notsent}}
        {{#hasresult}}
            <p class="mb-1">
                <strong>{{#str}} aitotal, assignfeedback_proctorai {{/str}}</strong>
                <span data-region="assignfeedback_proctorai-total">{{earned}}</span> / {{maxmarks}} ({{percentage}}%)
                {{#pagecount}}<span class="text-muted small">&middot; {{#str}} pagesn, assignfeedback_proctorai, {{pagecount}} {{/str}}</span>{{/pagecount}}
            </p>
            {{#needsreview}}
                <div class="alert alert-warning py-1 px-2 mb-2 small">{{#str}} summaryreview, assignfeedback_proctorai, {{reviewcount}} {{/str}}</div>
            {{/needsreview}}
            {{#canusegrade}}
                <p class="mb-2">
                    <button type="button" class="btn btn-sm btn-primary" data-action="assignfeedback_proctorai-usegrade" data-grade="{{suggestedgraderaw}}">
                        {{#str}} usegrade, assignfeedback_proctorai, {{suggestedgrade}} {{/str}}
                    </button>
                    <span class="text-muted small">/ {{maxgrade}}</span>
                    {{#prefilled}}<span class="d-block text-muted small">{{#str}} prefillednote, assignfeedback_proctorai {{/str}}</span>{{/prefilled}}
                </p>
            {{/canusegrade}}
            {{#percentonly}}
                <p class="text-muted small mb-2">{{#str}} percentonlynote, assignfeedback_proctorai {{/str}}</p>
            {{/percentonly}}
            {{#editable}}
                <p class="text-muted small mb-2">{{#str}} editmarksnote, assignfeedback_proctorai {{/str}}</p>
            {{/editable}}
            {{^approved}}
                <p class="text-muted small mb-2">{{#str}} draftnote, assignfeedback_proctorai {{/str}}</p>
            {{/approved}}
            <div class="table-responsive">
                <table class="table table-sm small mb-0">
                    <caption class="visually-hidden">{{#str}} perquestion, assignfeedback_proctorai {{/str}}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} question, assignfeedback_proctorai {{/str}}</th>
                            <th scope="col">{{#str}} marks, assignfeedback_proctorai {{/str}}</th>
                            <th scope="col">{{#str}} details, assignfeedback_proctorai {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#questions}}
                            <tr class="{{#needsreview}}table-warning{{/needsreview}}">
                                <th scope="row">{{label}}</th>
                                <td class="text-nowrap">
                                    {{#editable}}
                                        <label class="visually-hidden" for="{{panelid}}_mark{{index}}">{{#str}} markforquestion, assignfeedback_proctorai, {{label}} {{/str}}</label>
                                        <input type="number" id="{{panelid}}_mark{{index}}" class="form-control form-control-sm d-inline-block w-auto" style="max-width: 5.5em" min="0" max="{{maxraw}}" step="any" value="{{markraw}}" data-region="assignfeedback_proctorai-mark" data-index="{{index}}" data-max="{{maxraw}}">
                                        / {{max}}
                                    {{/editable}}
                                    {{^editable}}{{earned}} / {{max}}{{/editable}}
                                    {{#edited}}<div class="text-muted">{{#str}} aimark, assignfeedback_proctorai, {{aiearned}} {{/str}}</div>{{/edited}}
                                </td>
                                <td>
                                    {{#needsreview}}<div class="fw-bold">{{#str}} needsreview, assignfeedback_proctorai {{/str}}{{#reviewreason}}: {{reviewreason}}{{/reviewreason}}</div>{{/needsreview}}
                                    {{#studentanswer}}<div><span class="text-muted">{{#str}} studentanswer, assignfeedback_proctorai {{/str}}</span> {{studentanswer}}</div>{{/studentanswer}}
                                    {{#feedback}}<div>{{feedback}}</div>{{/feedback}}
                                    {{#reasoning}}<div class="text-muted">{{#str}} reasoning, assignfeedback_proctorai {{/str}} {{reasoning}}</div>{{/reasoning}}
                                    {{#confidence}}<div class="text-muted">{{#str}} confidence, assignfeedback_proctorai, {{confidence}} {{/str}}</div>{{/confidence}}
                                </td>
                            </tr>
                        {{/questions}}
                    </tbody>
                </table>
            </div>
        {{/hasresult}}
    </div>
</div>
